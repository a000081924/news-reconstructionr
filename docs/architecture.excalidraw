    {
      "type": "text", "id": "ps_storage_note", "x": 2160, "y": 780, "width": 800, "height": 50,
      "text": "Content addressed: the sha256 of the normalised PNG decides identity, so\nthe same scan re-encoded, or arriving as TIFF instead of PNG, still reuses its\nstored recognition rather than spending another GPU run.",
      "originalText": "Content addressed: the sha256 of the normalised PNG decides identity, so\nthe same scan re-encoded, or arriving as TIFF instead of PNG, still reuses its\nstored recognition rather than spending another GPU run.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
