    {
      "type": "text", "id": "ps_export_note", "x": 2062, "y": 1450, "width": 880, "height": 50,
      "text": "All three are written from the same corrected Page, so a saved edit shows up in every\nexport. A headline fixed in the browser survived a reload and appeared in all three\nformats during end-to-end verification.",
      "originalText": "All three are written from the same corrected Page, so a saved edit shows up in every\nexport. A headline fixed in the browser survived a reload and appeared in all three\nformats during end-to-end verification.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 500053, "version": 1, "versionNonce": 500054, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },

    {
