      "text": "POST   /api/documents               multipart -> {document_id, page_id, cached}\nPOST   /api/pages/{id}/recognize    {engine} -> {job_id}\nGET    /api/jobs/{id}/events        SSE stage stream, Last-Event-ID\nGET    /api/pages/{id}              page JSON, corrections merged in\nPUT    /api/pages/{id}/corrections  ·  GET /api/pages/{id}/export?format=",
