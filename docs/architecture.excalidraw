    {
      "type": "text", "id": "rc_bus_t", "x": 150, "y": 1592, "width": 240, "height": 35,
      "text": "JobBus\nper-job SSE fan-out",
      "originalText": "JobBus\nper-job SSE fan-out",
      "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400035, "version": 1, "versionNonce": 400036, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": "rc_bus", "lineHeight": 1.25
    },
    {
      "type": "text", "id": "rc_busnote", "x": 440, "y": 1575, "width": 700, "height": 50,
      "text": "Job state lives in the repository; the SSE stream is only a view over it.\nEvents carry monotonic ids, so a reconnecting client replays everything\nafter its cursor instead of orphaning the running job.",
      "originalText": "Job state lives in the repository; the SSE stream is only a view over it.\nEvents carry monotonic ids, so a reconnecting client replays everything\nafter its cursor instead of orphaning the running job.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400037, "version": 1, "versionNonce": 400038, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },

