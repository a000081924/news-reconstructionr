    {
      "type": "text", "id": "ps_sub", "x": 2062, "y": 296, "width": 860, "height": 33,
      "text": "repository/db.py  ·  services/corrections.py  ·  services/export.py  ·  domain/page.py\nSQLite metadata plus UUID-named blobs under .runtime/, gitignored, so no scan reaches git.",
      "originalText": "repository/db.py  ·  services/corrections.py  ·  services/export.py  ·  domain/page.py\nSQLite metadata plus UUID-named blobs under .runtime/, gitignored, so no scan reaches git.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
