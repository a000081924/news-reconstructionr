    },
    {
      "type": "text", "id": "ps_contract_code", "x": 2080, "y": 405, "width": 560, "height": 135,
      "text": "{\"schema_version\": 1, \"engine\": \"structure\",\n \"width\": 5079, \"height\": 7029, \"angle\": 90,\n \"image\": \"/api/pages/{id}/image\",\n \"blocks\": [{\"id\": 12, \"order\": 4,\n   \"label\": \"text\", \"bbox\": [x1, y1, x2, y2],\n   \"text\": \"<block text>\",\n   \"lines\": [{\"bbox\": [x1, y1, x2, y2],\n              \"text\": \"<recognised line>\",\n              \"score\": 0.93}]}]}",
      "originalText": "{\"schema_version\": 1, \"engine\": \"structure\",\n \"width\": 5079, \"height\": 7029, \"angle\": 90,\n \"image\": \"/api/pages/{id}/image\",\n \"blocks\": [{\"id\": 12, \"order\": 4,\n   \"label\": \"text\", \"bbox\": [x1, y1, x2, y2],\n   \"text\": \"<block text>\",\n   \"lines\": [{\"bbox\": [x1, y1, x2, y2],\n              \"text\": \"<recognised line>\",\n              \"score\": 0.93}]}]}",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 500011, "version": 1, "versionNonce": 500012, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "ps_contract_note", "x": 2690, "y": 400, "width": 270, "height": 115,
      "text": "domain/page.py owns\nthis shape and checks it\non every load: unique\nids and reading order,\nscores in [0,1], every\nbbox inside the page.\nStandard library only.",
      "originalText": "domain/page.py owns\nthis shape and checks it\non every load: unique\nids and reading order,\nscores in [0,1], every\nbbox inside the page.\nStandard library only.",
