    {
      "type": "text", "id": "ps_corr_code", "x": 2080, "y": 920, "width": 410, "height": 90,
      "text": "CREATE TABLE corrections(\n  page_id, engine,\n  block_id, line_index,\n  text NOT NULL,\n  PRIMARY KEY(page_id, engine,\n              block_id, line_index));",
      "originalText": "CREATE TABLE corrections(\n  page_id, engine,\n  block_id, line_index,\n  text NOT NULL,\n  PRIMARY KEY(page_id, engine,\n              block_id, line_index));",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 500029, "version": 1, "versionNonce": 500030, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "ps_corr_note", "x": 2532, "y": 905, "width": 420, "height": 115,
      "text": "Recognition output stays\nimmutable. A correction is\na record against the page,\nengine, block and line, not\na rewritten page document,\nso the diff stays\ninspectable.",
      "originalText": "Recognition output stays\nimmutable. A correction is\na record against the page,\nengine, block and line, not\na rewritten page document,\nso the diff stays\ninspectable.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 500031, "version": 1, "versionNonce": 500032, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "ps_corr_note2", "x": 2160, "y": 1050, "width": 800, "height": 50,
      "text": "save_page() clears corrections for that engine: line indices belong to one\nparticular recognition and must never move silently. corrections.apply() rebuilds\nblock.text from the corrected lines, so the reader and the exports agree.",
      "originalText": "save_page() clears corrections for that engine: line indices belong to one\nparticular recognition and must never move silently. corrections.apply() rebuilds\nblock.text from the corrected lines, so the reader and the exports agree.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 500033, "version": 1, "versionNonce": 500034, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },

